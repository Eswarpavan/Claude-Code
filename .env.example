# CatalystEdge settings. Copy to `.env` (never commit `.env`; it is in .gitignore) and fill in.
# Every key is optional: a missing key simply disables that source, and the app says so on Source Health.

# --- News and data (free tiers) -------------------------------------------------------------
FINNHUB_API_KEY=                 # https://finnhub.io/register  (news, earnings calendar, quote open)
TIINGO_API_KEY=                  # https://www.tiingo.com       (end-of-day prices; free plan is enough to start)
SEC_USER_AGENT=                  # "Your Name you@example.com"  (required by SEC for filings; not a secret)
MARKETAUX_API_KEY=               # optional: more news coverage (100 requests/day free)
ALPHAVANTAGE_API_KEY=            # optional: more news + earnings history (25 requests/day free)
OPENFDA_API_KEY=                 # optional: raises openFDA's daily cap
STOOQ_API_KEY=                   # optional: fallback prices (apikey from a captcha on stooq.com)
NEWS_WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,AVGO,NFLX,JPM,LLY,UNH,XOM,COST,CRM,ORCL,PLTR,UBER,INTC
TIINGO_NEWS_ENABLED=false        # Tiingo News needs the paid Power plan

# --- Email alerts (first configured provider wins) -------------------------------------------
ALERT_EMAIL_TO=                  # where alerts go
EMAIL_FROM=                      # verified sender, e.g. "CatalystEdge <alerts@yourdomain.com>"
RESEND_API_KEY=                  # https://resend.com (free: 3,000/month, 100/day)
SENDGRID_API_KEY=                # alternative (SendGrid no longer has a permanent free plan)
SMTP_HOST=                       # alternative, e.g. smtp.gmail.com with an app password
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DAILY_CAP=50
DAILY_DIGEST=false

# --- App ---------------------------------------------------------------------------------------
APP_PASSWORD=                    # set this if anyone else can reach the app (required in the cloud profile)
APP_SECRET=                      # long random string; keeps you logged in across restarts
SENTIMENT_MODEL=finbert          # finbert | distilroberta | deberta | lexicon
INSTALL_ML=true                  # false = skip PyTorch/FinBERT (use the labelled word-list fallback)
REFRESH_COOLDOWN_S=300
